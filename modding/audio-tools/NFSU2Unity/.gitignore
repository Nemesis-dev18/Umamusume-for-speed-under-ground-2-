# Unity
/Unity/[Ll]ibrary/
/Unity/[Tt]emp/
/Unity/[Oo]bj/
/Unity/[Bb]uild/
/Unity/[Bb]uilds/
/Unity/[Ll]ogs/
/Unity/[Uu]ser[Ss]ettings/
/Unity/*.csproj
/Unity/*.sln
/Unity/*.slnx
/Unity/.vs/
/Unity/.vscode/
/Unity/MemoryCaptures/
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
crashlytics-build.properties

# .NET tools
tools/**/bin/
tools/**/obj/

# Never commit game data or anything derived from it (renders, dumps, extracted assets)
/shots/
/dumps/
*.BIN
*.BUN
*.LZC
*.EXE

# Harness golden files: outputs of the original exe code, regenerated by tools/harness/gen_golden.py
tools/harness/golden/

# Python bytecode
__pycache__/
*.pyc
